<?xml version="1.0" encoding="utf-8"?>
<!-- Insets are applied in code (MainActivity.applyWindowInsets), not with
     fitsSystemWindows: the toolbar takes the status-bar inset as its own top padding so its
     background paints behind the status bar, and the scrolling content takes the
     navigation-bar inset. This replaced a paddingTop="?attr/actionBarSize" hack plus a
     per-API-level runtime correction, which guessed whether the action bar overlaid the
     content. Material 1.14 changed that answer and reintroduced the gap the guess existed to
     fix, so the guess is gone. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:windowBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/FlatToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/settingsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:divider="@drawable/divider_item"
            android:showDividers="middle"
            android:paddingBottom="48dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:divider="@drawable/divider_item"
                android:showDividers="middle"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Enable Hourly Chime (always visible) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/enable_hourly_chime"
                            android:textSize="18sp"
                            android:textColor="?android:textColor"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/enable_hourly_chime_description"
                            android:textSize="14sp"
                            android:textColor="?android:textColorSecondary"/>
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchService"
                        style="@style/HrlySwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/enable_hourly_chime" />
                </LinearLayout>

                <!-- Paused state. Pausing is only reachable from the notification, so
                     without this banner there is no way back once the shade is dismissed. -->
                <LinearLayout
                    android:id="@+id/containerPausedBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_media_pause"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="@string/status_paused_banner"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/status_paused_banner"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="12sp"
                        android:layout_marginEnd="12dp"/>

                    <Button
                        android:id="@+id/btnResumeChimes"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/action_resume"
                        android:textColor="?attr/colorPrimary"
                        app:strokeColor="?attr/colorPrimary"
                        app:cornerRadius="50dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="16dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerBatteryWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/stat_notify_error"
                        app:tint="#FF6E40"
                        android:contentDescription="Warning"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/battery_warning_text"
                        android:textColor="#FF6E40"
                        android:textSize="12sp"
                        android:layout_marginEnd="12dp"/>

                    <Button
                        android:id="@+id/btnFixBattery"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fix_button"
                        android:textColor="#FF6E40"
                        app:strokeColor="#FF6E40"
                        app:cornerRadius="50dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="16dp"/>
                </LinearLayout>

                <!-- All chime configuration, shown only while the service is enabled -->
                <LinearLayout
                    android:id="@+id/containerSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:divider="@drawable/divider_item"
                    android:showDividers="middle">

                    <!-- Chime mode (#11): sound / vibrate / both -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chime_mode"
                            android:textSize="18sp"
                            android:textColor="?android:textColor"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chime_mode_description"
                            android:textSize="14sp"
                            android:textColor="?android:textColorSecondary"/>

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/toggleChimeMode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:singleSelection="true"
                            app:selectionRequired="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnModeSound"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/mode_sound"
                                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.HRLY.Pill"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnModeVibrate"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/mode_vibrate"
                                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.HRLY.Pill"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnModeBoth"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/mode_both"
                                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.HRLY.Pill"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </LinearLayout>

                    <!-- Override silent/vibrate mode (#11) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/override_silent"
                                android:textSize="18sp"
                                android:textColor="?android:textColor"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/override_silent_description"
                                android:textSize="14sp"
                                android:textColor="?android:textColorSecondary"/>
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchOverrideSilent"
                            style="@style/HrlySwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/override_silent" />
                    </LinearLayout>

                    <!-- Single chime (#3/#8) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/single_chime"
                                android:textSize="18sp"
                                android:textColor="?android:textColor"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/single_chime_description"
                                android:textSize="14sp"
                                android:textColor="?android:textColorSecondary"/>
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchSimpleMode"
                            style="@style/HrlySwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/single_chime" />
                    </LinearLayout>

                    <!-- Custom Sounds + its pickers grouped so no divider splits them -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/containerCustomSoundsToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/custom_sounds"
                                android:textSize="18sp"
                                android:textColor="?android:textColor"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/custom_sounds_description"
                                android:textSize="14sp"
                                android:textColor="?android:textColorSecondary"/>
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchCustomSounds"
                            style="@style/HrlySwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/containerSoundPickers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtShortToneLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/short_tone"
                                    android:textColor="?android:textColor"/>

                                <TextView
                                    android:id="@+id/txtShortToneName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/default_tone"
                                    android:textSize="12sp"
                                    android:textColor="?android:textColorSecondary"/>
                            </LinearLayout>

                            <Button
                                android:id="@+id/btnTrimShort"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/trim_sound"
                                android:visibility="gone"
                                android:layout_marginEnd="4dp"
                                style="@style/Widget.MaterialComponents.Button.TextButton"/>

                            <Button
                                android:id="@+id/btnPickShort"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/choose_sound"
                                app:cornerRadius="50dp"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                            <ImageView
                                android:id="@+id/btnClearShort"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@android:drawable/ic_menu_close_clear_cancel"
                                android:visibility="gone"
                                android:clickable="true"
                                android:focusable="true"
                                android:contentDescription="@string/clear_sound_selection"
                                android:layout_marginStart="16dp"
                                app:tint="?android:textColorSecondary" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/rowLongTone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/long_tone"
                                    android:textColor="?android:textColor"/>

                                <TextView
                                    android:id="@+id/txtLongToneName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/default_tone"
                                    android:textSize="12sp"
                                    android:textColor="?android:textColorSecondary"/>
                            </LinearLayout>

                            <Button
                                android:id="@+id/btnTrimLong"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/trim_sound"
                                android:visibility="gone"
                                android:layout_marginEnd="4dp"
                                style="@style/Widget.MaterialComponents.Button.TextButton"/>

                            <Button
                                android:id="@+id/btnPickLong"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/choose_sound"
                                app:cornerRadius="50dp"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                            <ImageView
                                android:id="@+id/btnClearLong"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@android:drawable/ic_menu_close_clear_cancel"
                                android:visibility="gone"
                                android:clickable="true"
                                android:focusable="true"
                                android:contentDescription="@string/clear_sound_selection"
                                android:layout_marginStart="16dp"
                                app:tint="?android:textColorSecondary" />
                        </LinearLayout>

                    </LinearLayout>
                    </LinearLayout>

                    <!-- Custom timing + its slider grouped so no divider splits them.
                         Hidden entirely in single-chime mode (only one tone, so no gap). -->
                    <LinearLayout
                        android:id="@+id/containerCustomTiming"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <!-- Custom timing (#6) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/chime_timing"
                                android:textSize="18sp"
                                android:textColor="?android:textColor"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/chime_timing_description"
                                android:textSize="14sp"
                                android:textColor="?android:textColorSecondary"/>
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchTiming"
                            style="@style/HrlySwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/chime_timing" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/containerTiming"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/tone_gap_label"
                                android:textColor="?android:textColor"/>

                            <TextView
                                android:id="@+id/txtGapValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textStyle="bold"
                                android:textColor="?android:textColor"/>

                            <Button
                                android:id="@+id/btnGapReset"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:minWidth="0dp"
                                android:text="@string/reset"
                                style="@style/Widget.MaterialComponents.Button.TextButton"/>
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderGap"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="0"
                            android:valueTo="2000"
                            android:stepSize="25" />

                        <TextView
                            android:id="@+id/txtGapWarning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/tone_gap_warning"
                            android:textSize="12sp"
                            android:textColor="#FF6E40"/>
                    </LinearLayout>
                    </LinearLayout>

                    <!-- Quiet Hours + its pickers grouped so no divider splits them -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/containerQuietToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/quiet_hours"
                                android:textSize="18sp"
                                android:textColor="?android:textColor"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/quiet_hours_description"
                                android:textSize="14sp"
                                android:textColor="?android:textColorSecondary"/>
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchQuietHours"
                            style="@style/HrlySwitch"
                            android:layout_width="wrap_content"
                            android:contentDescription="@string/quiet_hours_description"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/containerQuietPickers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/quiet_start"
                                    android:textColor="?android:textColor"/>

                            </LinearLayout>

                            <Button
                                android:id="@+id/btnQuietStart"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10:00 PM"
                                app:cornerRadius="50dp"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/quiet_end"
                                    android:textColor="?android:textColor"/>

                            </LinearLayout>

                            <Button
                                android:id="@+id/btnQuietEnd"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="7:00 AM"
                                app:cornerRadius="50dp"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                        </LinearLayout>

                    </LinearLayout>
                    </LinearLayout>

                    <!-- Disable persistent notification (#7) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/minimize_notification"
                                android:textSize="18sp"
                                android:textColor="?android:textColor"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/minimize_notification_description"
                                android:textSize="14sp"
                                android:textColor="?android:textColorSecondary"/>

                            <TextView
                                android:id="@+id/txtMinimizeNote"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/minimize_notification_legacy_note"
                                android:textSize="12sp"
                                android:textColor="#FF6E40"
                                android:visibility="gone"/>
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchHideNextChime"
                            style="@style/HrlySwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/minimize_notification" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/debugLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="?android:statusBarColor"
                android:padding="16dp"
                app:layout_constraintTop_toBottomOf="@id/settingsContainer">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/debug_menu"
                    android:textColor="?android:textColor"
                    android:layout_gravity="start"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnTest8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    app:cornerRadius="50dp"
                    android:text="@string/test_8_logic" />

                <Button
                    android:id="@+id/btnTest12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    app:cornerRadius="50dp"
                    android:text="@string/test_12_logic" />

                <Button
                    android:id="@+id/btnTestNow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    app:cornerRadius="50dp"
                    android:text="@string/force_chime_now" />

                <Button
                    android:id="@+id/btnTestVibrate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    app:cornerRadius="50dp"
                    android:text="@string/test_vibration" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/footerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/footer_copyright"
                android:textSize="14sp"
                android:textColor="?android:textColorSecondary"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:textAlignment="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
