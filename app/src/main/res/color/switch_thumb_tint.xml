<?xml version="1.0" encoding="utf-8"?>
<!-- A custom ColorStateList REPLACES the widget's defaults, so it must cover
     enabled x checked, not just checked. Without the disabled entries a disabled switch fell
     through to the catch-all and looked identical to enabled-off, which reads as active.
     Disabled alphas follow M3: 38% for content, 12% for surfaces. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/light_content_secondary" android:alpha="0.38" />
    <item android:state_checked="true" android:color="@color/light_background_main" />
    <item android:color="@color/light_content_secondary" />
</selector>
