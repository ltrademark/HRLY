<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Hourly" parent="Theme.MaterialComponents.DayNight">

        <item name="colorAccent">@color/dark_brand_primary</item>

        <item name="colorPrimary">@color/dark_brand_primary</item>
        <item name="colorPrimaryVariant">@color/dark_brand_variant</item>
        <item name="colorOnPrimary">@color/dark_content_primary</item>
        <item name="colorSecondary">@color/dark_brand_secondary</item>

        <item name="android:listDivider">@color/dark_border</item>

        <item name="colorControlNormal">@color/dark_content_primary</item>
        <item name="colorControlActivated">@color/dark_brand_primary</item>

        <item name="android:windowBackground">@color/dark_background_main</item>
        <item name="android:colorBackground">@color/dark_background_main</item>
        <item name="android:textColor">@color/dark_content_primary</item>
        <item name="android:textColorSecondary">@color/dark_content_secondary</item>

        <item name="elevation">0dp</item>

        <!-- See the light theme: transparent so the toolbar shows through below API 35. -->
        <item name="android:statusBarColor">@android:color/transparent</item>

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="titleTextColor">@color/dark_content_primary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="FlatToolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/dark_background_offset</item>
        <item name="titleTextColor">@color/dark_content_primary</item>
        <item name="android:elevation">0dp</item>
    </style>
</resources>